# Copy to infra/.env (gitignored), fill in, then load before running Terraform:
#   set -a; source .env; set +a
#
# Find the org/account names in Snowsight:
#   SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();

SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Password logins need MFA; this makes Terraform send a push to approve.
SNOWFLAKE_AUTHENTICATOR=USERNAMEPASSWORDMFA
